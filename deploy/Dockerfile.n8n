# n8n para el despliegue en la nube.
#
# Render (y Railway) dan HTTPS por defecto: el certificado lo emite Let's Encrypt y
# el dominio es https://<servicio>.onrender.com. Por eso el puerto es el 10000
# (el que Render asigna) y no el 5678.
FROM docker.n8n.io/n8nio/n8n

USER root
WORKDIR /opt/paso-firme

# Los flujos viajan en la imagen: al arrancar, se importan si la instancia está vacía.
COPY workflows/ /opt/paso-firme/workflows/
COPY deploy/arrancar_con_flujos.sh /opt/paso-firme/arrancar_con_flujos.sh
RUN chmod +x /opt/paso-firme/arrancar_con_flujos.sh && chown -R node:node /opt/paso-firme

USER node

ENV N8N_PORT=10000
ENV N8N_LISTEN_ADDRESS=0.0.0.0
ENV N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
ENV GENERIC_TIMEZONE=Europe/Madrid
ENV TZ=Europe/Madrid
ENV N8N_DIAGNOSTICS_ENABLED=false

EXPOSE 10000

CMD ["sh", "/opt/paso-firme/arrancar_con_flujos.sh"]
