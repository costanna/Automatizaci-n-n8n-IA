    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// El webhook de la tienda va protegido: sin el token correcto, la peticion se\n// rechaza con un 401 y no se ejecuta nada.\n//\n// El token puede venir en la query (?token=...) o en la cabecera X-Webhook-Token.\n// En data/config.csv no esta el token, sino su hash SHA-256 (WEBHOOK_TOKEN_SHA256):\n// el fichero esta en el repositorio y el token no tiene que estarlo.\nconst crypto = require('crypto');\n\nconst config = {};\nfor (const item of $('Parsear configuracion').all()) {\n  const clave = String(item.json?.clave ?? '').trim();\n  const valor = String(item.json?.valor ?? '').trim();\n  if (clave) config[clave] = valor;\n}\n\nconst peticion = $('Webhook eventos').first().json ?? {};\nconst esperado = String(config.WEBHOOK_TOKEN_SHA256 ?? '').trim().toLowerCase();\nconst recibido = String(\n  peticion.query?.token ?? peticion.headers?.['x-webhook-token'] ?? peticion.headers?.['X-Webhook-Token'] ?? ''\n).trim();\n\n// Se comparan los dos hashes en tiempo constante: asi no se puede adivinar el token\n// midiendo cuanto tarda en contestar.\nconst huella = crypto.createHash('sha256').update(recibido, 'utf8').digest('hex');\nconst autorizado = esperado.length === 64 && recibido.length > 0\n  && crypto.timingSafeEqual(Buffer.from(huella, 'hex'), Buffer.from(esperado, 'hex'));\n\nreturn [{\n  json: {\n    ...peticion,\n    autorizado,\n    motivo: autorizado ? '' : (esperado.length === 0\n      ? 'No hay WEBHOOK_TOKEN_SHA256 en data/config.csv'\n      : 'El token del webhook no es valido'),\n  },\n}];\n"
      },
      "id": "d1000003-0000-4000-8000-000000000003",
      "name": "Comprobar el token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
        300
      ]
    },
