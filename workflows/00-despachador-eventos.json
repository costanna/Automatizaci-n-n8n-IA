    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// La app ha mandado un evento que este flujo no conoce. Se avisa a la tienda\n// por si es un fallo de la app, pero no se rompe nada.\nconst entrada = $input.first().json ?? {};\nconst emailTienda = $vars.EMAIL_MARISA || 'marisa@pasofirme.example';\nconst cuerpo = [\n  'La tienda ha avisado de un evento que no conozco:',\n  '',\n  'Evento: ' + (entrada.evento || '(vacio)'),\n  'Datos: ' + JSON.stringify(entrada.datos ?? {}).slice(0, 500),\n].join('\\n');\n\nreturn [{ json: { canal: 'email', email: emailTienda, asunto: 'Evento desconocido de la tienda', cuerpo } }];\n"
      },
