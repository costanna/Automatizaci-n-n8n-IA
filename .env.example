# Clave que n8n debe enviar en la cabecera X-API-Key para usar la API de la tienda
API_KEY=cambia-esta-clave
# Webhook de n8n que recibe los eventos de la tienda (dejar vacío para desactivarlo)
# El token es WEBHOOK_TOKEN (abajo): sin el, n8n rechaza el aviso.
# 1 = cargar datos de ejemplo la primera vez que arranca la app, 0 = arrancar vacía
SEED=1
# URL publica de n8n. En local, http://localhost:5678/; en la nube, la https del servicio.
# (La usa n8n para registrar sus webhooks: el del bot de Telegram, por ejemplo.)
N8N_WEBHOOK_URL=http://localhost:5678/
# URL publica de n8n (la que se usa para registrar sus webhooks, como el del bot).
# En la nube, la https del servicio.
N8N_URL_PUBLICA=http://localhost:5678/

# Secretos: los genera `python scripts/generar_secretos.py` y los mismos valores van en las
# credenciales de n8n (Webhooks - Tienda, Telegram - Token del bot y Panel - Marisa).
WEBHOOK_TOKEN=cambia-este-token
TELEGRAM_SECRET_TOKEN=cambia-este-token
PANEL_USUARIO=marisa
PANEL_CLAVE=cambia-esta-clave
